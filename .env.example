APP_NAME=bilingual-rag-mvp
APP_ENV=development
INGEST_SOURCE_DIR=./documents
INGEST_QDRANT_PATH=./data/qdrant
INGEST_COLLECTION=knowledge_chunks
INGEST_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INGEST_MODEL_CACHE=./data/models
INGEST_CHUNK_SIZE=1000
INGEST_CHUNK_OVERLAP=150
INGEST_OCR_ENABLED=true
INGEST_OCR_LANGUAGES=eng+chi_sim
INGEST_OCR_MIN_TEXT_CHARS=40
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_K=10
RETRIEVAL_RERANKER_ENABLED=false
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_MAX_OUTPUT_TOKENS=256
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
QA_CACHE_ENABLED=true
QA_CACHE_TTL_SECONDS=300
QA_CACHE_MAX_ENTRIES=256
QA_HISTORY_MAX_TURNS=3
QA_LOG_PATH=./artifacts/qa_events.jsonl
QA_GROUNDING_MIN_SUPPORT=0.5
